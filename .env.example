# Local development values. These credentials are intentionally disposable.
KIND_CLUSTER=jungle-local
APP_IMAGE=jungle-backend:local
APP_BUILD=1
POSTGRES_DB=jungle
POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-only
OIDC_ISSUER=http://host.docker.internal:8081/realms/jungle
OIDC_PROVIDER_CLIENT_ID=jungle-provider-local
OIDC_PROVIDER_CLIENT_SECRET=jungle-provider-secret-local-only
MINISTACK_HOST=localhost
MINISTACK_PORT=4566
AWS_REGION=us-east-1
